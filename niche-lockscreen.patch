@@ -0,0 +1,97 @@
+package echo.music.iad1tya.ui.lockscreen
+
+import android.app.KeyguardManager
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.provider.Settings
+import androidx.core.app.NotificationCompat
+import echo.music.iad1tya.R
+
+/**
+ * Shows [LockScreenPlayerActivity] over the lock screen when the screen wakes while music plays.
+ *
+ * Android blocks apps from opening screens out of the blue, so besides a direct attempt this posts
+ * a short-lived full-screen-intent notification (the same mechanism alarm and call apps use).
+ */
+object LockScreenLauncher {
+  private const val CHANNEL_ID = "lock_screen_player"
+  private const val NOTIFICATION_ID = 7711
+
+  fun launchIfLocked(context: Context) {
+    val keyguard = context.getSystemService(Context.KEYGUARD_SERVICE) as? KeyguardManager ?: return
+    if (!keyguard.isKeyguardLocked) return
+
+    val intent =
+      Intent(context, LockScreenPlayerActivity::class.java)
+        .addFlags(
+          Intent.FLAG_ACTIVITY_NEW_TASK or
+            Intent.FLAG_ACTIVITY_CLEAR_TOP or
+            Intent.FLAG_ACTIVITY_NO_ANIMATION
+        )
+
+    runCatching { context.startActivity(intent) }
+    runCatching { postFullScreenIntent(context, intent) }
+  }
+
+  private fun postFullScreenIntent(context: Context, intent: Intent) {
+    val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as? NotificationManager ?: return
+    if (!manager.areNotificationsEnabled()) return
+    if (Build.VERSION.SDK_INT >= 34 && !manager.canUseFullScreenIntent()) return
+
+    if (Build.VERSION.SDK_INT >= 26) {
+      val channel =
+        NotificationChannel(CHANNEL_ID, "Lock screen player", NotificationManager.IMPORTANCE_HIGH)
+          .apply {
+            setSound(null, null)
+            enableVibration(false)
+            setShowBadge(false)
+            lockscreenVisibility = Notification.VISIBILITY_SECRET
+          }
+      manager.createNotificationChannel(channel)
+    }
+
+    val pending =
+      PendingIntent.getActivity(
+        context,
+        0,
+        intent,
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+      )
+
+    val notification =
+      NotificationCompat.Builder(context, CHANNEL_ID)
+        .setSmallIcon(R.drawable.niche_notif)
+        .setContentTitle("NICHE")
+        .setContentText("Lock screen player")
+        .setPriority(NotificationCompat.PRIORITY_HIGH)
+        .setCategory(NotificationCompat.CATEGORY_TRANSPORT)
+        .setVisibility(NotificationCompat.VISIBILITY_SECRET)
+        .setAutoCancel(true)
+        .setFullScreenIntent(pending, true)
+        .build()
+
+    manager.notify(NOTIFICATION_ID, notification)
+    Handler(Looper.getMainLooper()).postDelayed({ manager.cancel(NOTIFICATION_ID) }, 4000L)
+  }
+
+  /** Opens the system page where the user can allow full-screen notifications (Android 14+). */
+  fun requestPermissionIfNeeded(context: Context) {
+    if (Build.VERSION.SDK_INT < 34) return
+    val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as? NotificationManager ?: return
+    if (manager.canUseFullScreenIntent()) return
+    runCatching {
+      context.startActivity(
+        Intent(Settings.ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT, Uri.parse("package:" + context.packageName))
+          .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+      )
+    }
+  }
+}
