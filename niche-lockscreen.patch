+/**
+ * Full-screen music player shown over the lock screen while a song plays: big clock, a row of
+ * album covers (swipe to change song), and play / pause / skip buttons.
+ */
+class LockScreenPlayerActivity : ComponentActivity() {
+  private var service by mutableStateOf<MusicService?>(null)
+
+  private val connection =
+    object : ServiceConnection {
+      override fun onServiceConnected(name: ComponentName?, binder: IBinder?) {
+        service = (binder as? MusicService.MusicBinder)?.service
+      }
+
+      override fun onServiceDisconnected(name: ComponentName?) {
+        service = null
+      }
+    }
+
+  // Close this screen as soon as the phone is unlocked or the screen turns off again.
+  private val closeReceiver =
+    object : BroadcastReceiver() {
+      override fun onReceive(context: Context?, intent: Intent?) {
+        finish()
+      }
+    }
+
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+
+    if (Build.VERSION.SDK_INT >= 27) {
+      setShowWhenLocked(true)
+      setTurnScreenOn(true)
+    } else {
+      @Suppress("DEPRECATION")
+      window.addFlags(
+        WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or
+          WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
+      )
+    }
+    WindowCompat.setDecorFitsSystemWindows(window, false)
+
+    runCatching {
+      registerReceiver(
+        closeReceiver,
+        IntentFilter().apply {
+          addAction(Intent.ACTION_USER_PRESENT)
+          addAction(Intent.ACTION_SCREEN_OFF)
+        },
+      )
+    }
+
+    bindService(Intent(this, MusicService::class.java), connection, Context.BIND_AUTO_CREATE)
+
+    setContent {
+      MaterialTheme(colorScheme = darkColorScheme()) {
+        LockScreenPlayer(service = service, onUnlock = { requestUnlock() })
+      }
+    }
+  }
+
+  private fun requestUnlock() {
+    val keyguard = getSystemService(KeyguardManager::class.java)
+    if (keyguard == null || !keyguard.isKeyguardLocked) {
+      finish()
+      return
+    }
+    keyguard.requestDismissKeyguard(
+      this,
+      object : KeyguardManager.KeyguardDismissCallback() {
+        override fun onDismissSucceeded() {
+          finish()
+        }
+      },
+    )
+  }
+
+  override fun onDestroy() {
+    runCatching { unregisterReceiver(closeReceiver) }
+    runCatching { unbindService(connection) }
+    super.onDestroy()
+  }
+}
+
+private data class LockItem(
+  val id: String,
+  val title: String,
+  val artist: String,
+  val artworkUrl: String?,
+)
+
+private fun MediaItem.toLockItem(): LockItem {
+  val meta = metadata
+  return LockItem(
+    id = mediaId,
+    title = meta?.title ?: mediaMetadata.title?.toString().orEmpty(),
+    artist =
+      meta?.artists?.joinToString(", ") { it.name } ?: mediaMetadata.artist?.toString().orEmpty(),
+    artworkUrl = meta?.thumbnailUrl?.resize(800, 800),
+  )
+}
+
+private fun Player.readItems(): List<LockItem> =
+  (0 until mediaItemCount).map { getMediaItemAt(it).toLockItem() }
+
+private fun Player.skipToPrevious() {
+  if (hasPreviousMediaItem()) seekToPreviousMediaItem() else seekTo(0L)
+}
+
+private fun Player.skipToNext() {
+  if (hasNextMediaItem()) seekToNextMediaItem()
+}
+
+private fun Player.togglePlayback() {
+  if (playWhenReady && playbackState != Player.STATE_ENDED) {
+    pause()
+  } else {
+    if (playbackState == Player.STATE_IDLE) prepare()
+    if (playbackState == Player.STATE_ENDED) seekToDefaultPosition()
+    play()
+  }
+}
+
+@Composable
+private fun LockScreenPlayer(service: MusicService?, onUnlock: () -> Unit) {
+  val context = LocalContext.current
+
+  val playerFlow: StateFlow<ExoPlayer?> =
+    remember(service) { service?.playerFlow ?: MutableStateFlow<ExoPlayer?>(null) }
+  val player by playerFlow.collectAsState()
+
+  var items by remember(player) { mutableStateOf(emptyList<LockItem>()) }
+  var index by remember(player) { mutableIntStateOf(0) }
+  var playing by remember(player) { mutableStateOf(false) }
+  var progress by remember(player) { mutableFloatStateOf(0f) }
+
+  DisposableEffect(player) {
+    val p = player
+    val listener =
+      object : Player.Listener {
+        override fun onEvents(source: Player, events: Player.Events) {
+          if (
+            events.containsAny(
+              Player.EVENT_TIMELINE_CHANGED,
+              Player.EVENT_MEDIA_ITEM_TRANSITION,
+              Player.EVENT_MEDIA_METADATA_CHANGED,
+            )
+          ) {
+            items = source.readItems()
+          }
+          index = source.currentMediaItemIndex.coerceAtLeast(0)
+          playing = source.playWhenReady && source.playbackState != Player.STATE_ENDED
+        }
+      }
+    if (p != null) {
+      items = p.readItems()
+      index = p.currentMediaItemIndex.coerceAtLeast(0)
+      playing = p.playWhenReady && p.playbackState != Player.STATE_ENDED
+      p.addListener(listener)
+    }
+    onDispose { p?.removeListener(listener) }
+  }
+
+  LaunchedEffect(player) {
+    while (true) {
+      val p = player
+      val d = p?.duration ?: 0L
+      progress = if (p != null && d > 0L) (p.currentPosition.toFloat() / d).coerceIn(0f, 1f) else 0f
+      delay(500L)
+    }
+  }
+
+  val safeIndex = index.coerceIn(0, (items.size - 1).coerceAtLeast(0))
+  val current = items.getOrNull(safeIndex)
+
+  Box(Modifier.fillMaxSize().background(Color.Black)) {
+    val backgroundUrl = current?.artworkUrl
+    // The whole screen takes the colours of the current album cover and fades when the song changes.
+    Crossfade(targetState = backgroundUrl, animationSpec = tween(700), label = "bg") { url ->
+      if (url != null) {
+        AsyncImage(
+          model = ImageRequest.Builder(context).data(url).build(),
+          contentDescription = null,
+          contentScale = ContentScale.Crop,
+          colorFilter = ColorFilter.colorMatrix(ColorMatrix().apply { setToSaturation(1.5f) }),
+          modifier = Modifier.fillMaxSize().blur(100.dp),
+        )
+      }
+    }
+    Box(
+      Modifier.fillMaxSize()
+        .background(
+          Brush.verticalGradient(listOf(Color(0x40000000), Color(0x00000000), Color(0x80000000)))
+        )
+    )
+
+    Column(
+      modifier = Modifier.fillMaxSize().statusBarsPadding().navigationBarsPadding(),
+      horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+      ClockBlock(Modifier.padding(top = 24.dp))
+      Spacer(Modifier.weight(1f))
+
+      if (items.isEmpty()) {
+        Text("Nothing playing", color = Color.White.copy(alpha = 0.7f), fontSize = 18.sp)
+      } else {
+        CoverRow(items = items, index = safeIndex) { page ->
+          val p = player
+          if (p != null && page in 0 until p.mediaItemCount && page != p.currentMediaItemIndex) {
+            p.seekTo(page, 0L)
+            p.play()
+          }
+        }
+        Spacer(Modifier.height(28.dp))
+        ControlBar(
+          current = current,
+          playing = playing,
+          progress = progress,
+          onPrevious = { player?.skipToPrevious() },
+          onToggle = { player?.togglePlayback() },
+          onNext = { player?.skipToNext() },
+        )
+      }
+
+      Spacer(Modifier.weight(1f))
+      UnlockHint(onUnlock)
+    }
+  }
+}
+
+private val GlassFill = Brush.verticalGradient(listOf(Color(0x44FFFFFF), Color(0x1AFFFFFF)))
+private val GlassBorder = Color(0x44FFFFFF)
+
+@Composable
+private fun CoverRow(items: List<LockItem>, index: Int, onPageSettled: (Int) -> Unit) {
+  val context = LocalContext.current
+  BoxWithConstraints(Modifier.fillMaxWidth()) {
+    val cardWidth = minOf(maxWidth * 0.62f, 280.dp)
+    val cardHeight = cardWidth + 52.dp
+    val sidePadding = (maxWidth - cardWidth) / 2
+    val pagerState =
+      rememberPagerState(initialPage = index.coerceIn(0, (items.size - 1).coerceAtLeast(0))) {
+        items.size
+      }
+    var userDragged by remember { mutableStateOf(false) }
+
+    // Song changed from outside (skip button, notification, auto-next): move the cards.
+    LaunchedEffect(index, items.size) {
+      if (
+        items.isNotEmpty() &&
+          index in items.indices &&
+          pagerState.settledPage != index &&
+          !pagerState.isScrollInProgress
+      ) {
+        userDragged = false
+        pagerState.animateScrollToPage(index)
+      }
+    }
+    // Remember that the finger (not the code) moved the cards.
+    LaunchedEffect(pagerState) {
+      pagerState.interactionSource.interactions.collect {
+        if (it is DragInteraction.Start) userDragged = true
+      }
+    }
+    // Finger swipe finished on a new card: play that song.
+    LaunchedEffect(pagerState) {
+      snapshotFlow { pagerState.settledPage }
+        .collect { page ->
+          if (userDragged) {
+            userDragged = false
+            onPageSettled(page)
+          }
+        }
+    }
+
+    HorizontalPager(
+      state = pagerState,
+      modifier = Modifier.fillMaxWidth().height(cardHeight + 28.dp),
+      contentPadding = PaddingValues(horizontal = sidePadding),
+      pageSize = PageSize.Fixed(cardWidth),
+      verticalAlignment = Alignment.CenterVertically,
+    ) { page ->
+      val offset = (pagerState.currentPage - page) + pagerState.currentPageOffsetFraction
+      val distance = abs(offset).coerceAtMost(2f)
+      val item = items.getOrNull(page)
+      val shape = RoundedCornerShape(28.dp)
+      Column(
+        Modifier.width(cardWidth)
+          .height(cardHeight)
+          .zIndex(2f - distance)
+          .graphicsLayer {
+            val s = 1f - 0.16f * distance
+            scaleX = s
+            scaleY = s
+            alpha = 1f - 0.3f * distance
+            rotationY = (offset * 28f).coerceIn(-40f, 40f)
+            translationX = offset * cardWidth.toPx() * 0.3f
+            cameraDistance = 14f * density
+          }
+          .clip(shape)
+          .background(GlassFill)
+          .border(1.dp, GlassBorder, shape)
+          .padding(12.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+      ) {
+        AsyncImage(
+          model = ImageRequest.Builder(context).data(item?.artworkUrl).build(),
+          contentDescription = null,
+          contentScale = ContentScale.Crop,
+          modifier =
+            Modifier.fillMaxWidth()
+              .aspectRatio(1f)
+              .clip(RoundedCornerShape(20.dp))
+              .background(Color(0x33FFFFFF)),
+        )
+        Spacer(Modifier.height(8.dp))
+        Text(
+          text = item?.title.orEmpty(),
+          color = Color.White,
+          fontSize = 16.sp,
+          fontWeight = FontWeight.SemiBold,
+          maxLines = 1,
+          overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+          text = item?.artist.orEmpty(),
+          color = Color.White.copy(alpha = 0.7f),
+          fontSize = 14.sp,
+          maxLines = 1,
+          overflow = TextOverflow.Ellipsis,
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun ControlBar(
+  current: LockItem?,
+  playing: Boolean,
+  progress: Float,
+  onPrevious: () -> Unit,
+  onToggle: () -> Unit,
+  onNext: () -> Unit,
+) {
+  val context = LocalContext.current
+  val shape = RoundedCornerShape(40.dp)
+  Row(
+    modifier =
+      Modifier.fillMaxWidth()
+        .padding(horizontal = 16.dp)
+        .clip(shape)
+        .background(GlassFill)
+        .border(1.dp, GlassBorder, shape)
+        .padding(horizontal = 12.dp, vertical = 10.dp),
+    verticalAlignment = Alignment.CenterVertically,
+    horizontalArrangement = Arrangement.spacedBy(4.dp),
+  ) {
+    RoundButton(Icons.Rounded.SkipPrevious, 40.dp, 26.dp, onPrevious)
+    RoundButton(
+      icon = if (playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+      size = 48.dp,
+      iconSize = 32.dp,
+      onClick = onToggle,
+    )
+    RoundButton(Icons.Rounded.SkipNext, 40.dp, 26.dp, onNext)
+    Spacer(Modifier.width(6.dp))
+    Column(
+      Modifier.weight(1f)
+        .clip(RoundedCornerShape(16.dp))
+        .background(Color(0x66000000))
+        .padding(start = 8.dp, end = 8.dp, top = 6.dp, bottom = 6.dp)
+    ) {
+      Row(verticalAlignment = Alignment.CenterVertically) {
+        AsyncImage(
+          model = ImageRequest.Builder(context).data(current?.artworkUrl).build(),
+          contentDescription = null,
+          contentScale = ContentScale.Crop,
+          modifier = Modifier.size(34.dp).clip(RoundedCornerShape(8.dp)),
+        )
+        Spacer(Modifier.width(8.dp))
+        Column {
+          Text(
+            text = current?.title.orEmpty(),
+            color = Color.White,
+            fontSize = 12.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+          )
+          Text(
+            text = current?.artist.orEmpty(),
+            color = Color.White.copy(alpha = 0.7f),
+            fontSize = 11.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+          )
+        }
+      }
+      Spacer(Modifier.height(5.dp))
+      Box(Modifier.fillMaxWidth().height(3.dp).clip(CircleShape).background(Color(0x33FFFFFF))) {
+        Box(
+          Modifier.fillMaxWidth(progress.coerceIn(0f, 1f))
+            .height(3.dp)
+            .clip(CircleShape)
+            .background(Color.White)
+        )
+      }
+    }
+  }
+}
+
+@Composable
+private fun ClockBlock(modifier: Modifier = Modifier) {
+  val context = LocalContext.current
+  var now by remember { mutableLongStateOf(System.currentTimeMillis()) }
+  LaunchedEffect(Unit) {
+    while (true) {
+      now = System.currentTimeMillis()
+      delay(5_000L)
+    }
+  }
+  val locale = Locale.getDefault()
+  val is24Hour = DateFormat.is24HourFormat(context)
+  val time = SimpleDateFormat(if (is24Hour) "HH:mm" else "h:mm", locale).format(Date(now))
+  val date = SimpleDateFormat("EEEE, MMMM d", locale).format(Date(now))
+
+  Column(modifier = modifier, horizontalAlignment = Alignment.CenterHorizontally) {
+    Text(
+      text = date,
+      color = Color.White.copy(alpha = 0.85f),
+      fontSize = 18.sp,
+      fontWeight = FontWeight.Medium,
+    )
+    Text(text = time, color = Color.White, fontSize = 64.sp, fontWeight = FontWeight.Bold)
+  }
+}
+
+@Composable
+private fun RoundButton(
+  icon: ImageVector,
+  size: Dp,
+  iconSize: Dp,
+  onClick: () -> Unit,
+  filled: Boolean = false,
+) {
+  Box(
+    modifier =
+      Modifier.size(size)
+        .clip(CircleShape)
+        .background(if (filled) Color(0x33FFFFFF) else Color.Transparent)
+        .clickable(onClick = onClick),
+    contentAlignment = Alignment.Center,
+  ) {
+    Icon(
+      imageVector = icon,
+      contentDescription = null,
+      tint = Color.White,
+      modifier = Modifier.size(iconSize),
+    )
+  }
+}
+
+@Composable
+private fun UnlockHint(onUnlock: () -> Unit) {
+  Box(
+    modifier =
+      Modifier.fillMaxWidth()
+        .height(88.dp)
+        .pointerInput(Unit) {
+          var total = 0f
+          detectVerticalDragGestures(
+            onDragStart = { total = 0f },
+            onDragEnd = { if (total < -120f) onUnlock() },
+            onDragCancel = {},
+          ) { change, dragAmount ->
+            change.consume()
+            total += dragAmount
+          }
+        }
+        .clickable { onUnlock() },
+    contentAlignment = Alignment.Center,
+  ) {
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+      Box(
+        Modifier.width(44.dp)
+          .height(5.dp)
+          .clip(CircleShape)
+          .background(Color.White.copy(alpha = 0.6f))
+      )
+      Spacer(Modifier.height(10.dp))
+      Text("Swipe up to unlock", color = Color.White.copy(alpha = 0.7f), fontSize = 14.sp)
+    }
+  }
+}
