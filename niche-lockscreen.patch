+++ b/app/src/main/kotlin/com/music/echo/playback/LyricsIsland.kt
@@ -0,0 +1,327 @@
+package echo.music.iad1tya.playback
+
+import android.content.Context
+import android.content.Intent
+import android.graphics.Color
+import android.graphics.PixelFormat
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.provider.Settings
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.media3.common.Player
+import echo.music.iad1tya.R
+import echo.music.iad1tya.db.entities.LyricsEntity
+import echo.music.iad1tya.lyrics.LyricsEntry
+import echo.music.iad1tya.lyrics.LyricsUtils
+
+/**
+ * A small floating "island" pill at the top of the screen that shows the current lyric line while
+ * music plays. Tap it to expand: title, artist, nearby lyric lines and previous / play / next.
+ *
+ * Needs the "Display over other apps" permission. Built from plain views so it does not need any
+ * activity or lifecycle owner.
+ */
+class LyricsIsland(
+  private val context: Context,
+  private val playerProvider: () -> Player?,
+) {
+  private val handler = Handler(Looper.getMainLooper())
+
+  private var enabled = false
+  private var title = ""
+  private var artist = ""
+  private var lines: List<LyricsEntry> = emptyList()
+  private var lastIndex = -2
+  private var expanded = false
+  private var attached = false
+
+  private var windowManager: WindowManager? = null
+  private var params: WindowManager.LayoutParams? = null
+  private var root: LinearLayout? = null
+  private var collapsedRow: LinearLayout? = null
+  private var collapsedText: TextView? = null
+  private var expandedBox: LinearLayout? = null
+  private var titleView: TextView? = null
+  private var artistView: TextView? = null
+  private var prevView: TextView? = null
+  private var currentView: TextView? = null
+  private var nextView: TextView? = null
+  private var playView: ImageView? = null
+
+  private val collapseRunnable = Runnable { setExpanded(false) }
+
+  private val tick =
+    object : Runnable {
+      override fun run() {
+        update()
+        if (enabled) handler.postDelayed(this, 300L)
+      }
+    }
+
+  fun setEnabled(value: Boolean) {
+    handler.post {
+      enabled = value
+      handler.removeCallbacks(tick)
+      if (value) tick.run() else detach()
+    }
+  }
+
+  fun setSong(title: String, artist: String, lines: List<LyricsEntry>) {
+    handler.post {
+      this.title = title
+      this.artist = artist
+      this.lines = lines
+      lastIndex = -2
+      if (enabled) update()
+    }
+  }
+
+  fun destroy() {
+    handler.post {
+      enabled = false
+      handler.removeCallbacksAndMessages(null)
+      detach()
+    }
+  }
+
+  private fun canDraw(): Boolean = runCatching { Settings.canDrawOverlays(context) }.getOrDefault(false)
+
+  private fun update() {
+    val p = playerProvider()
+    val wanted =
+      enabled &&
+        lines.isNotEmpty() &&
+        p != null &&
+        p.playbackState != Player.STATE_ENDED &&
+        (p.playWhenReady || expanded) &&
+        canDraw()
+    if (!wanted || p == null) {
+      detach()
+      return
+    }
+    attach()
+    if (!attached) return
+
+    val position = p.currentPosition
+    val index = lines.indexOfLast { it.time <= position }
+    if (index != lastIndex) {
+      lastIndex = index
+      bindLines(index)
+    }
+    playView?.setImageResource(if (p.playWhenReady) R.drawable.pause else R.drawable.play)
+  }
+
+  private fun bindLines(index: Int) {
+    collapsedText?.text = if (index >= 0) lines[index].text else title
+    titleView?.text = title
+    artistView?.text = artist
+    prevView?.text = lines.getOrNull(index - 1)?.text.orEmpty()
+    currentView?.text = if (index >= 0) lines[index].text else "♪"
+    nextView?.text = lines.getOrNull(index + 1)?.text.orEmpty()
+  }
+
+  private fun dp(value: Int): Int =
+    (value * context.resources.displayMetrics.density).toInt()
+
+  private fun screenWidth(): Int = context.resources.displayMetrics.widthPixels
+
+  private fun statusBarHeight(): Int {
+    val id = context.resources.getIdentifier("status_bar_height", "dimen", "android")
+    return if (id > 0) context.resources.getDimensionPixelSize(id) else dp(28)
+  }
+
+  private fun text(sizeSp: Float, color: Int, bold: Boolean = false, lines: Int = 1): TextView =
+    TextView(context).apply {
+      setTextSize(TypedValue.COMPLEX_UNIT_SP, sizeSp)
+      setTextColor(color)
+      maxLines = lines
+      ellipsize = TextUtils.TruncateAt.END
+      if (bold) setTypeface(typeface, Typeface.BOLD)
+    }
+
+  private fun icon(resId: Int, sizeDp: Int, onClick: () -> Unit): ImageView =
+    ImageView(context).apply {
+      setImageResource(resId)
+      setColorFilter(Color.WHITE)
+      setPadding(dp(12), dp(8), dp(12), dp(8))
+      layoutParams = LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp))
+      setOnClickListener {
+        onClick()
+        scheduleCollapse()
+      }
+    }
+
+  private fun buildView(): LinearLayout {
+    val box =
+      LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        background =
+          GradientDrawable().apply {
+            setColor(0xF2000000.toInt())
+            cornerRadius = dp(26).toFloat()
+          }
+        setPadding(dp(16), dp(8), dp(16), dp(8))
+        elevation = dp(6).toFloat()
+        setOnClickListener { setExpanded(!expanded) }
+      }
+
+    // Collapsed: a note icon and the current lyric line.
+    val row =
+      LinearLayout(context).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+      }
+    val note =
+      ImageView(context).apply {
+        setImageResource(R.drawable.music_note)
+        setColorFilter(Color.WHITE)
+        layoutParams = LinearLayout.LayoutParams(dp(18), dp(18)).apply { marginEnd = dp(8) }
+      }
+    val line = text(14f, Color.WHITE, bold = true).apply { maxWidth = (screenWidth() * 0.66f).toInt() }
+    row.addView(note)
+    row.addView(line)
+    box.addView(row)
+    collapsedRow = row
+    collapsedText = line
+
+    // Expanded: title, artist, three lyric lines, controls.
+    val big =
+      LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        visibility = View.GONE
+      }
+    titleView = text(16f, Color.WHITE, bold = true)
+    artistView = text(13f, 0xFFB5B5B5.toInt())
+    prevView = text(13f, 0xFF8A8A8A.toInt()).apply { setPadding(0, dp(12), 0, 0) }
+    currentView = text(19f, Color.WHITE, bold = true, lines = 3).apply { setPadding(0, dp(4), 0, dp(4)) }
+    nextView = text(13f, 0xFF8A8A8A.toInt())
+    big.addView(titleView)
+    big.addView(artistView)
+    big.addView(prevView)
+    big.addView(currentView)
+    big.addView(nextView)
+
+    val controls =
+      LinearLayout(context).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER
+        setPadding(0, dp(8), 0, 0)
+      }
+    controls.addView(
+      icon(R.drawable.skip_previous, 56) {
+        playerProvider()?.let { if (it.hasPreviousMediaItem()) it.seekToPreviousMediaItem() else it.seekTo(0L) }
+      }
+    )
+    val play =
+      icon(R.drawable.pause, 64) {
+        playerProvider()?.let { if (it.playWhenReady) it.pause() else it.play() }
+      }
+    playView = play
+    controls.addView(play)
+    controls.addView(
+      icon(R.drawable.skip_next, 56) {
+        playerProvider()?.let { if (it.hasNextMediaItem()) it.seekToNextMediaItem() }
+      }
+    )
+    big.addView(controls)
+    box.addView(big)
+    expandedBox = big
+    return box
+  }
+
+  private fun attach() {
+    if (attached) return
+    try {
+      val wm = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+      val view = buildView()
+      val lp =
+        WindowManager.LayoutParams(
+          ViewGroup.LayoutParams.WRAP_CONTENT,
+          ViewGroup.LayoutParams.WRAP_CONTENT,
+          WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+          WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+            WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+            WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+            WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+          PixelFormat.TRANSLUCENT,
+        )
+      lp.gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
+      lp.y = statusBarHeight() + dp(2)
+      if (Build.VERSION.SDK_INT >= 30) {
+        lp.layoutInDisplayCutoutMode =
+          WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+      }
+      wm.addView(view, lp)
+      windowManager = wm
+      params = lp
+      root = view
+      attached = true
+      expanded = false
+      lastIndex = -2
+    } catch (e: Exception) {
+      attached = false
+      root = null
+    }
+  }
+
+  private fun detach() {
+    handler.removeCallbacks(collapseRunnable)
+    if (!attached) return
+    runCatching { windowManager?.removeView(root) }
+    attached = false
+    expanded = false
+    root = null
+    params = null
+  }
+
+  private fun setExpanded(value: Boolean) {
+    if (!attached) return
+    expanded = value
+    expandedBox?.visibility = if (value) View.VISIBLE else View.GONE
+    collapsedRow?.visibility = if (value) View.GONE else View.VISIBLE
+    params?.let {
+      it.width = if (value) (screenWidth() * 0.92f).toInt() else ViewGroup.LayoutParams.WRAP_CONTENT
+      runCatching { windowManager?.updateViewLayout(root, it) }
+    }
+    handler.removeCallbacks(collapseRunnable)
+    if (value) scheduleCollapse()
+  }
+
+  private fun scheduleCollapse() {
+    handler.removeCallbacks(collapseRunnable)
+    handler.postDelayed(collapseRunnable, 8000L)
+  }
+
+  companion object {
+    /** Splits stored lyrics into timed lines; empty when there are no synced lyrics. */
+    fun parse(lyrics: String?): List<LyricsEntry> {
+      if (lyrics.isNullOrBlank() || lyrics == LyricsEntity.LYRICS_NOT_FOUND) return emptyList()
+      val parsed = runCatching { LyricsUtils.parseLyrics(lyrics) }.getOrNull() ?: return emptyList()
+      if (parsed.none { it.time > 0L }) return emptyList()
+      return parsed.filter { !it.isBackground && it.text.isNotBlank() }.sorted()
+    }
+
+    /** Opens the system page where the user allows "Display over other apps" for NICHE. */
+    fun requestOverlayPermission(context: Context) {
+      if (runCatching { Settings.canDrawOverlays(context) }.getOrDefault(false)) return
+      runCatching {
+        context.startActivity(
+          Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:" + context.packageName))
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        )
+      }
+    }
+  }
+}
